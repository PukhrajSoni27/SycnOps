{
  "name": "sycnops-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "SycnOps AI - Developer Workflow Automation Platform",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend"
  },
  "keywords": [
    "developer-workflow",
    "ai-automation",
    "github-integration",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "firebase": "^12.17.1",
    "mongodb": "^7.5.0",
    "next-auth": "^5.0.0-beta.32",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
